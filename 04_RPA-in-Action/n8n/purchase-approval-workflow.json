{
  "name": "Purchase Approval Workflow",
  "nodes": [
    {
      "id": "bd1de52b-8e11-4964-92d1-2e920c59c581",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -360,
        -180
      ],
      "parameters": {
        "content": "## Purchase Approval Workflow\nAuto-approves small purchase requests and flags larger ones for manager review — instantly, at the moment the request is submitted. No manual checking, no email back-and-forth.\n\n**Test it:** activate the workflow, open the \"Purchase Request Submitted\" node, copy its Production URL, and open that in a browser — it's a real web form. Fill it in and submit.\n\nAmounts at or below the threshold (default $500, set in the next node) are auto-approved; everything above is flagged for manager review.",
        "height": 340,
        "width": 380,
        "color": 6
      }
    },
    {
      "id": "c3dcdd23-fd9b-4a8f-8333-344bde3ddaa0",
      "name": "Purchase Request Submitted",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -360,
        120
      ],
      "webhookId": "5fb191a3-52b6-48dd-8def-f4307429be8a",
      "parameters": {
        "formTitle": "Purchase Request",
        "formDescription": "Submit a purchase request. Requests at or under the auto-approval threshold are approved instantly; larger ones are flagged for manager review.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Employee Name",
              "fieldName": "employeeName",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Department",
              "fieldName": "department",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Item",
              "fieldName": "item",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Amount ($)",
              "fieldName": "amount",
              "fieldType": "number",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "purchase-request"
        }
      }
    },
    {
      "id": "a20bc066-f23d-4a8a-b9fa-0abe8d9cdda3",
      "name": "Set Approval Threshold",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -120,
        120
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "322e85c6-bf00-4b75-8a27-266eb99afdf8",
              "name": "approvalThreshold",
              "value": 500,
              "type": "number"
            },
            {
              "id": "06e44524-efd1-4120-9923-a22eea862838",
              "name": "amount",
              "value": "={{ Number($json.amount) }}",
              "type": "number"
            },
            {
              "id": "e3a1e178-1a2b-4c3d-9e4f-5a6b7c8d9e0f",
              "name": "employeeName",
              "value": "={{ $json.employeeName }}",
              "type": "string"
            },
            {
              "id": "f4b2f289-2b3c-5d4e-af5a-6b7c8d9e0f1a",
              "name": "department",
              "value": "={{ $json.department }}",
              "type": "string"
            },
            {
              "id": "05c3039a-3c4d-6e5f-ba6b-7c8d9e0f1a2b",
              "name": "item",
              "value": "={{ $json.item }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
